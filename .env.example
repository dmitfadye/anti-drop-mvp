# PostgreSQL (для Docker/production)
PG_DSN=postgresql://anti_drop:anti_drop@localhost:5433/anti_drop

# SQLite (fallback для локальной разработки без Docker)
# DATABASE_PATH=./data/anti_drop_mvp.db

# Общие настройки
APP_ENV=sandbox
SANDBOX_MODE=true
LOG_LEVEL=INFO

# Лимиты
MAX_CLIENT_COMMENT_LENGTH=1000
MAX_IDEMPOTENCY_KEY_LENGTH=128
MAX_SUBJECT_LENGTH=128
MAX_EVALUATION_ID_LENGTH=128
MAX_LIST_LIMIT=100
DEFAULT_LIST_LIMIT=20
