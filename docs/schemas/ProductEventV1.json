{
  "$defs": {
    "EventMetadata": {
      "additionalProperties": false,
      "properties": {
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "schema_version": {
          "const": "ProductEventV1",
          "default": "ProductEventV1",
          "title": "Schema Version",
          "type": "string"
        },
        "template_version": {
          "default": "warning-templates-2026.10.08.p2",
          "pattern": "^[a-zA-Z0-9._-]{1,80}$",
          "title": "Template Version",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "maximum": 3600000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "localization_version": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9._-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Localization Version"
        },
        "template_status": {
          "anyOf": [
            {
              "enum": [
                "draft",
                "native_reviewed",
                "legal_reviewed",
                "approved",
                "deprecated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Status"
        },
        "assignment_method": {
          "anyOf": [
            {
              "const": "deterministic_hash",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignment Method"
        },
        "question_id": {
          "anyOf": [
            {
              "pattern": "^q[0-9]{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Id"
        },
        "score_value": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Value"
        }
      },
      "title": "EventMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "risk_evaluated",
        "alert_delivered",
        "alert_viewed",
        "language_selected",
        "help_started",
        "case_created",
        "case_confirmed",
        "safe_action_confirmed",
        "request_failed",
        "experiment_assigned",
        "template_rendered",
        "translation_fallback",
        "understanding_survey_submitted",
        "scoring_recorded",
        "pre_transfer_advised"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "evaluation_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "pattern": "^(sub|cp|dev|evt|src|ep|case|tpl)_[a-f0-9]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "experiment_id": {
      "anyOf": [
        {
          "pattern": "^exp-[a-z0-9.-]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Id"
    },
    "experiment_arm": {
      "anyOf": [
        {
          "enum": [
            "control",
            "treatment"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Arm"
    },
    "template_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9_]{3,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Id"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "ru",
            "uz",
            "tg",
            "ky",
            "en",
            "zh",
            "ar"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "locale": {
      "anyOf": [
        {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locale"
    },
    "rule_version": {
      "pattern": "^[a-zA-Z0-9._-]{1,80}$",
      "title": "Rule Version",
      "type": "string"
    },
    "threshold_version": {
      "pattern": "^[a-zA-Z0-9._-]{1,80}$",
      "title": "Threshold Version",
      "type": "string"
    },
    "subject_pseudonym": {
      "anyOf": [
        {
          "pattern": "^(sub|cp|dev|evt|src|ep|case|tpl)_[a-f0-9]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Pseudonym"
    },
    "outcome_code": {
      "anyOf": [
        {
          "enum": [
            "ok",
            "failed",
            "cancelled",
            "confirmed_sandbox",
            "unknown",
            "arm_control",
            "arm_treatment",
            "rendered_draft_translation",
            "fallback_to_control_locale",
            "understood_next_step",
            "did_not_understand",
            "safe_action_chosen",
            "unsafe_action_chosen",
            "declined_advisory",
            "accepted_advisory",
            "rejected_input"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome Code"
    },
    "metadata": {
      "$ref": "#/$defs/EventMetadata"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "evaluation_id",
    "rule_version",
    "threshold_version"
  ],
  "title": "ProductEventV1",
  "type": "object"
}
