# Build context hygiene: image carries only what the api/eval runtime needs.
# Everything else is mounted at run time (reports, .local) or not needed.
.venv/
app/.venv
.git/
__pycache__/
*.py[oc]
.pytest_cache/
pgdata/
data/
.local/
reports/
frontend/node_modules/
frontend/.next/
*.db
*.sqlite
*.sqlite3
.env
# .env.example intentionally excluded: it points PG_DSN at host localhost,
# which is unreachable from inside a container. Runtime env comes from
# compose (PG_DSN=postgres:5432) or code defaults (SQLite fallback).
.env.example
.idea/
.vscode/
.DS_Store
*.log
